<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет-карточка: учим слова прямо на домашнем экране.
     Один макет на все случаи — RemoteViews не умеет подставлять разные разметки на лету,
     поэтому лишние блоки просто прячутся (setViewVisibility). Так же дешевле по Binder:
     каждое обновление виджета летит через межпроцессную транзакцию. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Шапка: урок и прогресс обязательного минимума -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_line1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#C9A54A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:text="@string/widget_loading" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:padding="3dp"
            android:src="@drawable/widget_refresh"
            android:contentDescription="@string/widget_refresh_hint" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:max="1"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress" />

    <!-- Вопрос: немецкое слово и кнопка озвучки -->
    <LinearLayout
        android:id="@+id/widget_question_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_speak"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:padding="4dp"
            android:src="@drawable/widget_sound"
            android:contentDescription="@string/widget_speak_hint" />
    </LinearLayout>

    <!-- Перевод: показывается у карточки после «Показать перевод» -->
    <TextView
        android:id="@+id/widget_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#C9A54A"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Четыре варианта ответа, сеткой 2×2 -->
    <LinearLayout
        android:id="@+id/widget_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_opt0"
                style="@style/WidgetOption"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_opt1"
                style="@style/WidgetOption"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_opt2"
                style="@style/WidgetOption"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_opt3"
                style="@style/WidgetOption"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Карточка: сначала «Показать перевод», затем честная самооценка -->
    <LinearLayout
        android:id="@+id/widget_flip_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_flip_left"
            style="@style/WidgetOption"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/widget_flip_right"
            style="@style/WidgetOption"
            android:layout_marginStart="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Строка состояния: серия, хвосты, «данные от…», «всё сделано» -->
    <TextView
        android:id="@+id/widget_line2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#8A8A8A"
        android:textSize="11sp"
        android:text="" />
</LinearLayout>
