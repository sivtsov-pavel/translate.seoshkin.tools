<?xml version="1.0" encoding="utf-8"?>
<!-- Экран поверх блокировки: сверху подсказка и крестик, посередине карточка виджета,
     снизу кнопка «Разблокировать».

     Фон непрозрачный: полупрозрачный поверх обоев замка делал текст нечитаемым на
     светлых обоях, а тёмная плашка читается всегда. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12100E"
    android:padding="16dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/lock_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lock_hint"
            android:textColor="#B9B2A6"
            android:textSize="13sp" />

        <!-- «Не сейчас»: карточка уходит, телефон остаётся заблокированным. Без этой
             кнопки единственным выходом была бы разблокировка — то есть шантаж. -->
        <TextView
            android:id="@+id/lock_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#B9B2A6"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Сюда кладётся вид карточки — тот же, что у виджета и уведомления -->
    <FrameLayout
        android:id="@+id/lock_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/lock_unlock"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/lock_unlock"
        android:textColor="#12100E"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/widget_btn_gold" />
</LinearLayout>
